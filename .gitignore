# ============================================
# DEPENDENCIAS
# ============================================
**/node_modules/
**/.pnp
**/.pnp.js
**/.yarn/cache
**/.yarn/unplugged
**/.yarn/build-state.yml
**/.yarn/install-state.gz
**/bower_components/
**/jspm_packages/

# ============================================
# VARIABLES DE ENTORNO
# ============================================
# Archivos de entorno (excepto .env.example)
.env
.env.local
.env.development
.env.production
.env.test
**/.env
**/.env.local
**/.env.development
**/.env.production
**/.env.test
# Nota: .env.example NO está ignorado intencionalmente

